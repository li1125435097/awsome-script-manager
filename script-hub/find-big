#!/usr/bin/env bash
# --- ase-meta ---
# author: li1125435097
# desc: Find largest regular files under a path (default .)
# constant: root=. (search root directory)
# constant: limit=15 (number of files to list)
# source: https://github.com/li1125435097/awsome-script-manager/blob/main/script-hub/find-big
# --- end ---
set -euo pipefail

root="${1:-.}"
limit="${2:-15}"

if [[ ! -d $root ]]; then
  echo "find-big: not a directory: $root" >&2
  exit 1
fi

find "$root" -type f -printf '%s\t%p\n' 2>/dev/null \
  | sort -rn \
  | head -n "$limit" \
  | awk '{
      size=$1; $1=""; sub(/^\t/, "", $0);
      hum=size; unit="B";
      if (hum>=1073741824) { hum=hum/1073741824; unit="G" }
      else if (hum>=1048576) { hum=hum/1048576; unit="M" }
      else if (hum>=1024) { hum=hum/1024; unit="K" }
      printf "%8.1f%s  %s\n", hum, unit, $0
    }'
