#!/bin/bash
# port-transmit, a script to manage SSH tunnels

TUNNEL_FILE="$HOME/.ssh_tunnels"
touch "$TUNNEL_FILE"

# 格式: 本地端口|远程IP|远程端口|SSH目标
TUNNELS=(
    "7303|127.0.0.1|7303|199"
    "26379|127.0.0.1|26379|199"
)

WATCH_INTERVAL=30

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 跨平台：检查端口是否被监听，返回纯净的 PID
check_port() {
    local port=$1
    local pid=""
    if command -v lsof &> /dev/null; then
        pid=$(lsof -Pi :"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1)
    fi
    if [ -z "$pid" ]; then
        # 使用 netstat 提取 PID，并用 tr 彻底清除可能的 \r 换行符，最后 head -n 1 防止重复
        pid=$(netstat -ano 2>/dev/null | grep ":$port " | grep "LISTENING" | awk '{print $NF}' | head -n 1)
    fi
    echo "$pid"
}

# 跨平台：检查进程是否存活
is_process_alive() {
    local pid=$1
    # 防御性检查：如果 PID 为空或非纯数字，直接返回 false
    if ! [[ "$pid" =~ ^[0-9]+$ ]]; then return 1; fi

    # 1. Linux 环境：使用 kill -0
    if kill -0 "$pid" 2>/dev/null; then return 0; fi

    # 2. Windows 环境：优先通过 netstat 检查该 PID 是否仍在监听任何端口
    # 既然我们是通过 netstat 找到的 PID，只要它还在 netstat 里，就是活的
    if netstat -ano 2>/dev/null | grep -q "$pid"; then return 0; fi

    # 3. Windows 备用方案：tasklist (加上 tr -d '\r' 防止匹配失败)
    if tasklist /FI "PID eq $pid" 2>/dev/null | tr -d '\r' | grep -q "$pid"; then return 0; fi

    return 1
}

# 跨平台：终止进程
kill_process() {
    local pid=$1
    kill "$pid" 2>/dev/null || taskkill //F //PID "$pid" >/dev/null 2>&1
}

show_help() {
    echo "用法: $0 {start|watch|list|exit}"
    echo "  start          一键启动所有预设的 SSH 隧道"
    echo "  watch          守护模式：启动隧道并周期性检测，断线自动重连 (Ctrl+C 退出)"
    echo "  list           列出当前所有正在运行的隧道及其状态"
    echo "  exit <本地端口>  停止并清理指定本地端口的隧道"
    echo "  exit all        停止并清理所有正在运行的隧道"
}

ensure_tunnel() {
    local config="$1"
    local quiet="${2:-false}"

    IFS='|' read -r local_port remote_ip remote_port ssh_target <<< "$config"

    local existing_pid=$(check_port "$local_port")
    if [ -n "$existing_pid" ] && is_process_alive "$existing_pid"; then
        if [ "$quiet" != "true" ]; then
            echo -e "${YELLOW}跳过: 本地端口 $local_port 已被占用 (PID: $existing_pid)。${NC}"
        fi
        return 0
    fi

    sed -i "/|${local_port}|/d" "$TUNNEL_FILE" 2>/dev/null
    [ -n "$existing_pid" ] && kill_process "$existing_pid"

    if [ "$quiet" = "true" ]; then
        echo -e "${YELLOW}[$(date '+%H:%M:%S')] 隧道 $local_port 断开，正在重连...${NC}"
    else
        echo "正在建立隧道: 本地:$local_port -> $ssh_target ($remote_ip:$remote_port) ..."
    fi

    ssh -o ServerAliveInterval=60 -o ExitOnForwardFailure=yes -N \
        -L "${local_port}:${remote_ip}:${remote_port}" "$ssh_target" &

    local wait_count=0
    local new_pid=""
    while [ $wait_count -lt 10 ]; do
        new_pid=$(check_port "$local_port")
        if [ -n "$new_pid" ]; then break; fi
        sleep 0.5
        ((wait_count++))
    done

    if [ -n "$new_pid" ]; then
        echo "${new_pid}|${local_port}|${remote_ip}:${remote_port}|${ssh_target}|$(date '+%Y-%m-%d %H:%M:%S')" >> "$TUNNEL_FILE"
        if [ "$quiet" = "true" ]; then
            echo -e "${GREEN}[$(date '+%H:%M:%S')] 隧道 $local_port 已恢复 (PID: $new_pid)${NC}"
        else
            echo -e "${GREEN}成功: 隧道 $local_port 已建立 (PID: $new_pid)${NC}"
        fi
        return 0
    fi

    echo -e "${RED}失败: 隧道 $local_port 建立超时，请检查 SSH 配置或网络。${NC}"
    return 1
}

start_tunnel() {
    for config in "${TUNNELS[@]}"; do
        ensure_tunnel "$config"
    done
}

watch_tunnels() {
    trap 'echo -e "\n${YELLOW}已停止 watch 守护。${NC}"; exit 0' INT TERM

    echo -e "${GREEN}开始守护隧道 (检测间隔 ${WATCH_INTERVAL}s)，Ctrl+C 退出...${NC}"
    for config in "${TUNNELS[@]}"; do
        ensure_tunnel "$config"
    done

    while true; do
        sleep "$WATCH_INTERVAL"
        for config in "${TUNNELS[@]}"; do
            ensure_tunnel "$config" true
        done
    done
}

list_tunnels() {
    echo -e "${YELLOW}ID | PID   | 本地端口 | 远程目标             | SSH 主机 | 状态${NC}"
    echo "---------------------------------------------------------------"
    local temp_file=$(mktemp)
    local active_count=0

    while IFS='|' read -r pid local_port remote_target ssh_target start_time; do
        [ -z "$pid" ] && continue
        if is_process_alive "$pid"; then
            status="${GREEN}运行中${NC}"
            printf "%-2s | %-5s | %-8s | %-20s | %-8s | %b\n" "$((++active_count))" "$pid" "$local_port" "$remote_target" "$ssh_target" "$status"
            echo "${pid}|${local_port}|${remote_target}|${ssh_target}|${start_time}" >> "$temp_file"
        else
            status="${RED}已断开${NC}"
            printf "%-2s | %-5s | %-8s | %-20s | %-8s | %b\n" "-" "$pid" "$local_port" "$remote_target" "$ssh_target" "$status"
        fi
    done < <(tr -d '\r' < "$TUNNEL_FILE")

    mv "$temp_file" "$TUNNEL_FILE"
    [ $active_count -eq 0 ] && echo "当前没有正在运行的隧道。"
}

exit_tunnel() {
    local local_port="$1"
    if [ "$local_port" = "all" ]; then
        local count=0
        while IFS='|' read -r pid port _ _ _; do
            [ -z "$pid" ] && continue
            echo "正在停止本地端口 $port 的隧道 (PID: $pid) ..."
            kill_process "$pid"
            ((count++))
        done < <(tr -d '\r' < "$TUNNEL_FILE")
        > "$TUNNEL_FILE"
        if [ $count -gt 0 ]; then
            echo -e "${GREEN}成功: 已停止 $count 个隧道并清理。${NC}"
        else
            echo -e "${YELLOW}警告: 未找到正在运行的隧道。${NC}"
        fi
        return 0
    fi

    if [ -z "$local_port" ]; then
        echo -e "${RED}错误: 请提供要停止的本地端口号。${NC}"
        show_help
        return 1
    fi

    local pid=$(grep "|${local_port}|" "$TUNNEL_FILE" | cut -d'|' -f1)
    if [ -n "$pid" ]; then
        echo "正在停止本地端口 $local_port 的隧道 (PID: $pid) ..."
        kill_process "$pid"
        sed -i "/|${local_port}|/d" "$TUNNEL_FILE"
        echo -e "${GREEN}成功: 隧道已停止并清理。${NC}"
    else
        local running_pid=$(check_port "$local_port")
        if [ -n "$running_pid" ]; then
            kill_process "$running_pid"
            echo -e "${GREEN}成功: 端口 $local_port 的进程 (PID: $running_pid) 已被终止。${NC}"
        else
            echo -e "${YELLOW}警告: 未找到本地端口 $local_port 对应的隧道。${NC}"
        fi
    fi
}

case "$1" in
    start) start_tunnel ;;
    watch) watch_tunnels ;;
    list)  list_tunnels ;;
    exit)  exit_tunnel "$2" ;;
    *)     show_help ;;
esac
