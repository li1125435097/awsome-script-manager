#!/usr/bin/env bash
set -euo pipefail

_ase_script="${BASH_SOURCE[0]}"
while [[ -L "$_ase_script" ]]; do
  _ase_link_dir=$(cd "$(dirname "$_ase_script")" && pwd)
  _ase_script=$(readlink "$_ase_script")
  [[ $_ase_script != /* ]] && _ase_script="$_ase_link_dir/$_ase_script"
done
ASE_ROOT="$(cd "$(dirname "$_ase_script")" && pwd)"
export ASE_DEFAULT_GIT_ROOT="$ASE_ROOT"
# shellcheck source=lib/ase-common.sh
source "$ASE_ROOT/lib/ase-common.sh"

usage() {
  local green="" reset=""
  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi
  cat <<EOF
Usage: ase <command> [options] [args]

Commands (aliases in parentheses):
  ${green}list${reset} (ls, l)                 List scripts (name and description from script header)
  ${green}info${reset} (if) <name>             Show script metadata (author, desc, constants, source)
  ${green}update${reset} (ud, u)               Sync data/script-hub.list from git remote
  ${green}search${reset} (se, s) <query>       Fuzzy-search script names in script-hub.list
  ${green}pull${reset} (p) <name> [...]        Pull script(s) from remote script-hub into ASE_SCRIPTS_DIR
  ${green}install${reset} (i) <name> [-a]      Symlink script to ~/bin (or /usr/local/bin with -a)
  ${green}remove${reset} (uninstall, rm, ui) <name>
                               Remove installed symlinks from ~/bin and /usr/local/bin
  ${green}installed${reset} (id)               List scripts recorded in data/install.list
  ${green}run${reset} (r) <name> [-- args]     Run a script
  ${green}uninstallme${reset} [-y]             Remove ase install (bin links, share, config, completion hooks)

Environment / config:
  ASE_SCRIPTS_DIR      Local scripts directory (required)
  ASE_CONFIG           Config file (default: ~/.config/ase/config)

Options:
  install -a           Install to /usr/local/bin instead of ~/bin
EOF
}

cmd_list() {
  ase_require_scripts_dir
  local names=() name intro n len max=0
  local green="" reset=""

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    names+=("$name")
    len=${#name}
    (( len > max )) && max=$len
  done < <(ase_enumerate_scripts)

  if [[ ${#names[@]} -eq 0 ]]; then
    local red=""
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
      red=$'\033[31m'
      reset=$'\033[0m'
    fi
    echo "${red}ase list: (none)${reset}"
    return 0
  fi

  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  for name in "${names[@]}"; do
    intro=$(ase_script_desc "$ASE_SCRIPTS_DIR/$name" 2>/dev/null || true)
    if [[ -z $intro ]]; then
      intro="(empty)"
    fi
    # shellcheck disable=SC2059
    printf "${green}%-${max}s${reset}  %s\n" "$name" "$intro"
  done
}

cmd_info() {
  [[ $# -ge 1 ]] || ase_die "info: missing script name"
  local name=$1 script author desc source constant
  local has_constants=0
  local blue="" reset=""

  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    # VS Code / Cursor Dark+ variable color (#9CDCFE)
    blue=$'\033[38;2;156;220;254m'
    reset=$'\033[0m'
  fi

  ase_require_scripts_dir
  script=$(ase_resolve_script_path "$name") || exit $?

  # shellcheck disable=SC2059
  printf '%sname:     %s%s\n' "$blue" "$name" "$reset"
  # shellcheck disable=SC2059
  printf '%spath:     %s%s\n' "$blue" "$script" "$reset"

  if ase_script_has_meta_block "$script"; then
    author=$(ase_script_meta_get "$script" author)
    if [[ -n $author ]]; then
      # shellcheck disable=SC2059
      printf '%sauthor:   %s%s\n' "$blue" "$author" "$reset"
    fi

    desc=$(ase_script_meta_get "$script" desc)
    if [[ -n $desc ]]; then
      # shellcheck disable=SC2059
      printf '%sdesc:     %s%s\n' "$blue" "$desc" "$reset"
    fi

    source=$(ase_script_meta_get "$script" source)
    if [[ -n $source ]]; then
      # shellcheck disable=SC2059
      printf '%ssource:   %s%s\n' "$blue" "$source" "$reset"
    fi

    while IFS= read -r constant; do
      [[ -n $constant ]] || continue
      if (( ! has_constants )); then
        # shellcheck disable=SC2059
        printf '%sconstants:%s\n' "$blue" "$reset"
        has_constants=1
      fi
      local re='^([^=[:space:]]+)=(.+)[[:space:]]+\(([^)]*)\)[[:space:]]*$'
      if [[ $constant =~ $re ]]; then
        # shellcheck disable=SC2059
        printf '%s  %-20s %s%s\n' "$blue" "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "$reset"
      else
        # shellcheck disable=SC2059
        printf '%s  %s%s\n' "$blue" "$constant" "$reset"
      fi
    done < <(ase_script_meta_constants "$script")
  else
    desc=$(ase_script_desc "$script" 2>/dev/null || true)
    if [[ -n $desc ]]; then
      # shellcheck disable=SC2059
      printf '%sdesc:     %s%s\n' "$blue" "$desc" "$reset"
    fi
  fi
}

cmd_complete_names() {
  ase_enumerate_scripts
}

cmd_run() {
  [[ $# -ge 1 ]] || ase_die "run: missing script name"

  local name=$1
  shift
  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  local script
  script=$(ase_resolve_script_path "$name") || exit $?

  if [[ -x $script ]]; then
    exec "$script" "$@"
  fi
  exec bash "$script" "$@"
}

cmd_update() {
  ase_load_config

  if ! command -v git >/dev/null 2>&1; then
    ase_die "git not found"
  fi

  local remote_ref list_rel list_path
  remote_ref=$(ase_git_remote_ref)
  list_rel=$ASE_SCRIPT_HUB_LIST_REL
  list_path=$(ase_script_hub_list_path)

  git -C "$ASE_GIT_ROOT" fetch "$ASE_GIT_REMOTE" || ase_die "git fetch failed"
  git -C "$ASE_GIT_ROOT" rev-parse --verify "$remote_ref" >/dev/null 2>&1 || \
    ase_die "remote ref not found: $remote_ref"

  if ! git -C "$ASE_GIT_ROOT" cat-file -e "$remote_ref:$list_rel" 2>/dev/null; then
    ase_die "remote file not found: $list_rel"
  fi

  mkdir -p "$(dirname "$list_path")"
  git -C "$ASE_GIT_ROOT" show "$remote_ref:$list_rel" >"$list_path"
  local green="" reset=""
  if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi
  # shellcheck disable=SC2059
  echo "${green}ase update: synced $list_path${reset}" >&2
}

cmd_search() {
  [[ $# -ge 1 ]] || ase_die "search: missing query"
  local query=$*

  ase_load_config
  local list_path
  list_path=$(ase_script_hub_list_path)
  if [[ ! -f $list_path ]]; then
    ase_die "script-hub.list not found ($list_path); run: ase update"
  fi

  local search_sh="$ASE_ROOT/algorithm/search-records.sh"
  [[ -f $search_sh ]] || ase_die "search: algorithm not found ($search_sh)"

  local out line name
  if ! out=$(bash "$search_sh" "$query" "$list_path"); then
    return 1
  fi

  local green="" reset=""
  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name=${line#*$'\t'}
    [[ -n $name ]] || name=$line
    # shellcheck disable=SC2059
    printf "${green}%s${reset}\n" "$name"
  done <<< "$out"
}

cmd_pull() {
  [[ $# -ge 1 ]] || ase_die "pull: missing script name"

  ase_load_config
  mkdir -p "$ASE_SCRIPTS_DIR"

  if ! command -v git >/dev/null 2>&1; then
    ase_die "git not found"
  fi

  local remote_ref
  remote_ref=$(ase_git_remote_ref)
  git -C "$ASE_GIT_ROOT" fetch "$ASE_GIT_REMOTE" || ase_die "git fetch failed"
  git -C "$ASE_GIT_ROOT" rev-parse --verify "$remote_ref" >/dev/null 2>&1 || \
    ase_die "remote ref not found: $remote_ref"

  local name git_path local_path pulled=0 skipped=0
  local green="" reset=""
  if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi
  for name in "$@"; do
    if [[ -z $name || $name == *"/"* || $name == *".."* ]]; then
      ase_die "invalid script name: ${name:-<empty>}"
    fi

    git_path=$(ase_hub_script_git_path "$name")
    if ! git -C "$ASE_GIT_ROOT" cat-file -e "$remote_ref:$git_path" 2>/dev/null; then
      echo "ase pull: not in remote script-hub: $name" >&2
      continue
    fi

    local_path="$ASE_SCRIPTS_DIR/$name"
    if [[ -f $local_path ]]; then
      if ase_can_prompt; then
        if ! ase_prompt_yn "本地已有 $name，是否覆盖？" n; then
          echo "ase pull: skipped $name" >&2
          ((skipped++)) || true
          continue
        fi
      else
        echo "ase pull: skipped $name (already exists; use a TTY to confirm overwrite)" >&2
        ((skipped++)) || true
        continue
      fi
    fi

    git -C "$ASE_GIT_ROOT" show "$remote_ref:$git_path" >"$local_path"
    ase_maybe_chmod_executable "$local_path"
    # shellcheck disable=SC2059
    echo "ase pull: ${green}$name${reset} -> $local_path" >&2
    ((pulled++)) || true
  done

  # shellcheck disable=SC2059
  echo "${green}ase pull: pulled $pulled, skipped $skipped${reset}" >&2
}

cmd_installed() {
  ase_load_config
  local names=() name intro len max=0
  local green="" reset=""

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    names+=("$name")
    len=${#name}
    (( len > max )) && max=$len
  done < <(ase_read_install_names)

  if [[ ${#names[@]} -eq 0 ]]; then
    local red=""
    if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
      red=$'\033[31m'
      reset=$'\033[0m'
    fi
    echo "${red}ase installed: (none)${reset}" >&2
    return 0
  fi

  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  for name in "${names[@]}"; do
    intro=""
    if [[ -d ${ASE_SCRIPTS_DIR:-} && -f $ASE_SCRIPTS_DIR/$name ]]; then
      intro=$(ase_script_desc "$ASE_SCRIPTS_DIR/$name" 2>/dev/null || true)
    fi
    if [[ -z $intro ]]; then
      intro="(not in ASE_SCRIPTS_DIR)"
    fi
    # shellcheck disable=SC2059
    printf "${green}%-${max}s${reset}  %s\n" "$name" "$intro"
  done
}

cmd_complete_hub_names() {
  ase_read_script_hub_names 2>/dev/null || true
}

cmd_install() {
  local all_users=0
  local positional=()

  while [[ $# -gt 0 ]]; do
    case $1 in
      -a)
        all_users=1
        shift
        ;;
      --)
        shift
        positional+=("$@")
        break
        ;;
      -*)
        usage
        exit 1
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  [[ ${#positional[@]} -ge 1 ]] || ase_die "install: missing script name"
  local name=${positional[0]}

  ase_require_scripts_dir

  local script target canon
  script=$(ase_resolve_script_path "$name") || exit $?
  canon=$(ase_canonical_path "$script")

  local green="" reset=""
  if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  if (( all_users )); then
    if [[ ! -w $ASE_SYSTEM_BIN ]] 2>/dev/null; then
      ase_die "cannot write to $ASE_SYSTEM_BIN; try: sudo ASE_CONFIG=\${ASE_CONFIG:-\$HOME/.config/ase/config} ase install $name -a"
    fi
    ase_install_bin_entry "$ASE_SYSTEM_BIN" "$name" "$canon"
    # shellcheck disable=SC2059
    echo "installed ${green}$name${reset} -> $ASE_SYSTEM_BIN/$name" >&2
    ase_warn_path_missing "$ASE_SYSTEM_BIN"
  else
    mkdir -p "$ASE_BIN_USER"
    ase_install_bin_entry "$ASE_BIN_USER" "$name" "$canon"
    # shellcheck disable=SC2059
    echo "installed ${green}$name${reset} -> $ASE_BIN_USER/$name" >&2
    ase_warn_path_missing "$ASE_BIN_USER"
  fi

  ase_install_list_add "$name"
}

cmd_remove() {
  [[ $# -ge 1 ]] || ase_die "remove: missing script name"
  local name=$1

  ase_load_config

  local script_path="$ASE_SCRIPTS_DIR/$name"
  local canon=""
  if [[ -f $script_path ]]; then
    canon=$(ase_canonical_path "$script_path")
  fi

  local bindir link_path green="" reset=""
  if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi
  for bindir in "$ASE_BIN_USER" "$ASE_SYSTEM_BIN"; do
    link_path="$bindir/$name"
    if ase_remove_bin_entry_if_matches "$link_path" "$canon" "$script_path"; then
      # shellcheck disable=SC2059
      echo "removed ${green}$link_path${reset}" >&2
    fi
  done

  ase_forget_cmd_hash "$name"
  ase_install_list_remove "$name"
}

cmd_uninstallme() {
  local assume_yes=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      -y | --yes)
        assume_yes=1
        shift
        ;;
      -h | --help)
        echo "Usage: ase uninstallme [-y]" >&2
        echo "  Removes packaged ase install: script symlinks in bin, ase in PATH," >&2
        echo "  share tree, ~/.config/ase, and completion profile/bashrc hooks." >&2
        echo "  Does not delete ASE_SCRIPTS_DIR (your pulled scripts)." >&2
        return 0
        ;;
      *)
        ase_die "uninstallme: unknown option: $1"
        ;;
    esac
  done

  local share_from_path share_from_cmd cfg_file cfg_dir
  local -a share_dirs=() bin_dirs=() deferred_paths=()
  local bindir link_path name s git_root found

  share_from_path=$ASE_ROOT
  share_from_cmd=$(ase_detect_share_from_command 2>/dev/null) || share_from_cmd=""

  cfg_file="${ASE_CONFIG:-$HOME/.config/ase/config}"
  if [[ $cfg_file == "~/"* ]]; then
    cfg_file="$HOME/${cfg_file#~/}"
  elif [[ $cfg_file == "~" ]]; then
    cfg_file="$HOME"
  fi
  cfg_dir=$(dirname "$cfg_file")

  if ase_try_source_config; then
    :
  else
    ASE_BIN_USER="${ASE_BIN_USER:-$HOME/bin}"
  fi

  if ase_share_looks_installed "$share_from_path" && ase_should_remove_share_dir "$share_from_path" "$share_from_cmd"; then
    share_dirs+=("$share_from_path")
  fi
  if [[ -n $share_from_cmd ]]; then
    found=0
    for s in "${share_dirs[@]}"; do
      [[ $s == "$share_from_cmd" ]] && found=1
    done
    (( found )) || share_dirs+=("$share_from_cmd")
  fi
  if [[ -n ${ASE_GIT_ROOT:-} ]]; then
    git_root=$(ase_canonical_path "$ASE_GIT_ROOT" 2>/dev/null) || git_root=$ASE_GIT_ROOT
    if ase_share_looks_installed "$git_root" && ase_should_remove_share_dir "$git_root" "$share_from_cmd"; then
      found=0
      for s in "${share_dirs[@]}"; do
        [[ $s == "$git_root" ]] && found=1
      done
      (( found )) || share_dirs+=("$git_root")
    fi
  fi

  if [[ ${#share_dirs[@]} -eq 0 ]]; then
    ase_die "uninstallme: cannot detect an installed ase share directory"
  fi

  if [[ -z ${ASE_SCRIPTS_DIR:-} ]]; then
    for s in "${share_dirs[@]}"; do
      if [[ -d "$s/scripts" ]]; then
        ASE_SCRIPTS_DIR="$s/scripts"
        break
      fi
    done
  fi

  bin_dirs=("$ASE_SYSTEM_BIN" /usr/bin "$HOME/bin")
  [[ -n ${ASE_BIN_USER:-} ]] && bin_dirs+=("$ASE_BIN_USER")

  echo "ase uninstallme: will remove:" >&2
  for s in "${share_dirs[@]}"; do
    echo "  share: $s" >&2
  done
  echo "  config: $cfg_dir" >&2
  echo "  completion: /etc/profile.d/ase-completion.sh, /etc/bash_completion.d/ase, ~/.bashrc completion/path blocks" >&2
  echo "  ase/asm/sm symlinks under: ${bin_dirs[*]}" >&2
  for s in "${share_dirs[@]}"; do
    while IFS= read -r name; do
      [[ -n $name ]] || continue
      echo "    $name (from $s/data/install.list)" >&2
    done < <(ase_read_install_names_from_file "$s/data/install.list")
  done
  if [[ -n ${ASE_SCRIPTS_DIR:-} ]]; then
    echo "  (keeping scripts dir: $ASE_SCRIPTS_DIR)" >&2
  fi

  if (( ! assume_yes )); then
    ase_can_prompt || ase_die "uninstallme: not a TTY; use -y to confirm"
    ase_prompt_yn "Proceed with uninstall?" n || ase_die "uninstallme: cancelled"
  fi

  for s in "${share_dirs[@]}"; do
    while IFS= read -r name; do
      [[ -n $name ]] || continue
      script_path=""
      if [[ -n ${ASE_SCRIPTS_DIR:-} ]]; then
        script_path="$ASE_SCRIPTS_DIR/$name"
      elif [[ -f "$s/scripts/$name" ]]; then
        script_path="$s/scripts/$name"
      fi
      ase_remove_script_bin_links "$name" "$script_path"
    done < <(ase_read_install_names_from_file "$s/data/install.list")
  done

  for s in "${share_dirs[@]}"; do
    for bindir in "${bin_dirs[@]}"; do
      [[ -n $bindir ]] || continue
      for name in ase asm sm; do
        link_path="$bindir/$name"
        if ase_remove_ase_bin_symlink "$link_path" "$s"; then
          echo "ase uninstallme: removed $link_path" >&2
        fi
      done
    done
  done

  ase_remove_bashrc_completion_block
  ase_remove_bashrc_path_block
  ase_remove_system_completion_hooks

  if [[ -d $cfg_dir ]]; then
    rm -rf "$cfg_dir"
    echo "ase uninstallme: removed $cfg_dir" >&2
  fi

  for name in ase asm sm; do
    ase_forget_cmd_hash "$name"
  done

  for s in "${share_dirs[@]}"; do
    found=0
    for x in "${deferred_paths[@]}"; do
      [[ $x == "$s" ]] && found=1
    done
    (( found )) || deferred_paths+=("$s")
  done
  ase_deferred_rm_paths "${deferred_paths[@]}"
  for s in "${deferred_paths[@]}"; do
    echo "ase uninstallme: scheduled removal of $s" >&2
  done
  echo "ase uninstallme: done (share removal runs in background after exit)" >&2
}

ase_normalize_cmd() {
  case "$1" in
    if) echo info ;;
    i) echo install ;;
    ls | l) echo list ;;
    ud | u) echo update ;;
    p) echo pull ;;
    uninstall | rm | ui) echo remove ;;
    r) echo run ;;
    se | s) echo search ;;
    id) echo installed ;;
    *) echo "$1" ;;
  esac
}

main() {
  local cmd
  cmd=$(ase_normalize_cmd "${1:-}")

  case "$cmd" in
    list) cmd_list ;;
    info) cmd_info "${@:2}" ;;
    update) cmd_update "${@:2}" ;;
    search) cmd_search "${@:2}" ;;
    pull) cmd_pull "${@:2}" ;;
    install) cmd_install "${@:2}" ;;
    remove) cmd_remove "${@:2}" ;;
    installed) cmd_installed "${@:2}" ;;
    uninstallme) cmd_uninstallme "${@:2}" ;;
    run) cmd_run "${@:2}" ;;
    __complete_names) cmd_complete_names ;;
    __complete_hub_names) cmd_complete_hub_names ;;
    -h | --help | help | "") usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
