#!/usr/bin/env bash
set -euo pipefail

_ase_script="${BASH_SOURCE[0]}"
while [[ -L "$_ase_script" ]]; do
  _ase_link_dir=$(cd "$(dirname "$_ase_script")" && pwd)
  _ase_script=$(readlink "$_ase_script")
  [[ $_ase_script != /* ]] && _ase_script="$_ase_link_dir/$_ase_script"
done
ASE_ROOT="$(cd "$(dirname "$_ase_script")" && pwd)"
export ASE_DEFAULT_GIT_ROOT="$ASE_ROOT"
# shellcheck source=lib/ase-common.sh
source "$ASE_ROOT/lib/ase-common.sh"

usage() {
  cat <<'EOF'
Usage: ase <command> [options] [args]

Commands:
  list                 List scripts (name and first-line description)
  update [-s]          Sync scripts from git remote into ASE_SCRIPTS_DIR
  install <name> [-a]  Symlink script to ~/bin (or /usr/local/bin with -a)
  remove <name>        Remove installed symlinks from ~/bin and /usr/local/bin
  run <name> [-- args] Run a script

Environment / config:
  ASE_SCRIPTS_DIR      Local scripts directory (required)
  ASE_CONFIG           Config file (default: ~/.config/ase/config)

Options:
  update -s            On name conflict, overwrite local with remote
  install -a           Install to /usr/local/bin instead of ~/bin
EOF
}

cmd_list() {
  ase_require_scripts_dir
  local names=() name intro n len max=0
  local green="" reset=""

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    names+=("$name")
    len=${#name}
    (( len > max )) && max=$len
  done < <(ase_enumerate_scripts)

  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  for name in "${names[@]}"; do
    intro=$(ase_script_description_line "$ASE_SCRIPTS_DIR/$name" 2>/dev/null || true)
    if [[ -z $intro ]]; then
      intro="(empty)"
    fi
    # shellcheck disable=SC2059
    printf "${green}%-${max}s${reset}  %s\n" "$name" "$intro"
  done
}

cmd_complete_names() {
  ase_enumerate_scripts
}

cmd_run() {
  [[ $# -ge 1 ]] || ase_die "run: missing script name"

  local name=$1
  shift
  if [[ ${1:-} == "--" ]]; then
    shift
  fi

  local script
  script=$(ase_resolve_script_path "$name") || exit $?

  if [[ -x $script ]]; then
    exec "$script" "$@"
  fi
  exec bash "$script" "$@"
}

cmd_update() {
  local save_remote=0
  OPTIND=1
  while getopts ":s" opt; do
    case $opt in
      s) save_remote=1 ;;
      *) usage; exit 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  ase_load_config

  if ! command -v git >/dev/null 2>&1; then
    ase_die "git not found"
  fi

  local remote_ref
  remote_ref=$(ase_git_remote_ref)

  git -C "$ASE_GIT_ROOT" fetch "$ASE_GIT_REMOTE" || ase_die "git fetch failed"
  git -C "$ASE_GIT_ROOT" rev-parse --verify "$remote_ref" >/dev/null 2>&1 || \
    ase_die "remote ref not found: $remote_ref"

  local added=0 skipped=0 overwritten=0
  local git_path base local_path

  _ase_update_list_remote_files() {
    if [[ -n $ASE_SCRIPTS_REL ]]; then
      git -C "$ASE_GIT_ROOT" ls-tree -r --name-only "$remote_ref" -- "${ASE_SCRIPTS_REL}/" 2>/dev/null || true
    else
      git -C "$ASE_GIT_ROOT" ls-tree "$remote_ref" 2>/dev/null | awk '$2 == "blob" { print $4 }'
    fi
  }

  while IFS= read -r git_path; do
    [[ -n $git_path ]] || continue
    base=$(basename "$git_path")
    [[ -n $base ]] || continue

    local_path="$ASE_SCRIPTS_DIR/$base"

    if [[ -f $local_path ]]; then
      if (( save_remote )); then
        git -C "$ASE_GIT_ROOT" show "$remote_ref:$git_path" >"$local_path"
        ase_maybe_chmod_executable "$local_path"
        ((overwritten++)) || true
      else
        ((skipped++)) || true
      fi
    else
      mkdir -p "$ASE_SCRIPTS_DIR"
      git -C "$ASE_GIT_ROOT" show "$remote_ref:$git_path" >"$local_path"
      ase_maybe_chmod_executable "$local_path"
      ((added++)) || true
    fi
  done < <(_ase_update_list_remote_files)

  echo "ase update: added $added, skipped $skipped, overwritten $overwritten" >&2
}

cmd_install() {
  local all_users=0
  local positional=()

  while [[ $# -gt 0 ]]; do
    case $1 in
      -a)
        all_users=1
        shift
        ;;
      --)
        shift
        positional+=("$@")
        break
        ;;
      -*)
        usage
        exit 1
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  [[ ${#positional[@]} -ge 1 ]] || ase_die "install: missing script name"
  local name=${positional[0]}

  ase_require_scripts_dir

  local script target canon
  script=$(ase_resolve_script_path "$name") || exit $?
  canon=$(ase_canonical_path "$script")

  if (( all_users )); then
    if [[ ! -w $ASE_SYSTEM_BIN ]] 2>/dev/null; then
      ase_die "cannot write to $ASE_SYSTEM_BIN; try: sudo ASE_CONFIG=\${ASE_CONFIG:-\$HOME/.config/ase/config} ase install $name -a"
    fi
    ase_install_bin_entry "$ASE_SYSTEM_BIN" "$name" "$canon"
    echo "installed $name -> $ASE_SYSTEM_BIN/$name" >&2
    ase_warn_path_missing "$ASE_SYSTEM_BIN"
  else
    mkdir -p "$ASE_BIN_USER"
    ase_install_bin_entry "$ASE_BIN_USER" "$name" "$canon"
    echo "installed $name -> $ASE_BIN_USER/$name" >&2
    ase_warn_path_missing "$ASE_BIN_USER"
  fi
}

cmd_remove() {
  [[ $# -ge 1 ]] || ase_die "remove: missing script name"
  local name=$1

  ase_load_config

  local script_path="$ASE_SCRIPTS_DIR/$name"
  local canon=""
  if [[ -f $script_path ]]; then
    canon=$(ase_canonical_path "$script_path")
  fi

  local bindir link_path
  for bindir in "$ASE_BIN_USER" "$ASE_SYSTEM_BIN"; do
    link_path="$bindir/$name"
    if ase_remove_bin_entry_if_matches "$link_path" "$canon" "$script_path"; then
      echo "removed $link_path" >&2
    fi
  done

  ase_forget_cmd_hash "$name"
}

main() {
  case "${1:-}" in
    list) cmd_list ;;
    update) cmd_update "${@:2}" ;;
    install) cmd_install "${@:2}" ;;
    remove) cmd_remove "${@:2}" ;;
    run) cmd_run "${@:2}" ;;
    __complete_names) cmd_complete_names ;;
    -h | --help | help | "") usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
